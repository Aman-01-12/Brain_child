<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSCameraUsageDescription</key>
	<string>Camera access is required for secure video interviews and calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Microphone access is required for secure video interviews and calls.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.inter.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com-inter-app</string>
			</array>
		</dict>
	</array>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>InterLiveKitServerURL</key>
	<string>ws://localhost:7880</string>
	<key>InterTokenServerURL</key>
	<string>http://localhost:3000</string>
	<!-- App Transport Security: full ATS enforcement is KEPT for public hosts, so a
	     cloud token server (https://) and cloud LiveKit (wss://) must still present a
	     valid TLS 1.2+ certificate. NSAllowsLocalNetworking only exempts loopback,
	     .local and private/link-local addresses, which is what LAN dev testing needs:
	     the local livekit-server (ws://localhost:7880) and a token server reached at
	     the host Mac's LAN IP (http://192.168.x.x:3000) from a second device.
	     NSAllowsArbitraryLoads is deliberately NOT set — it would disable ATS for
	     public hosts too. Remove this key once both endpoints are HTTPS/WSS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- macOS 15 gates LAN access behind the Local Network privacy permission.
	     Declaring this string gives the user a meaningful prompt when the app first
	     contacts the token server on another machine during two-device testing. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Inter connects to a token server on your local network when testing calls across two devices.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Screen sharing captures this app's secure call surface.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Calendar access lets Inter show your schedule and sync meetings to your calendar.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Calendar access lets Inter show your schedule and sync meetings to your calendar.</string>
</dict>
</plist>
