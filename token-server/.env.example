# ===========================================================================
# Inter Token Server — Environment Variables
# Copy this file to .env and fill in your values.
# ===========================================================================

# Redis connection URL
# Default (dev): redis://localhost:6379
# Production: Use Upstash Redis URL
REDIS_URL=redis://localhost:6379

# PostgreSQL connection URL
# Default (dev): postgresql://localhost:5432/inter_dev
# Production: Use Neon PostgreSQL URL
DATABASE_URL=postgresql://localhost:5432/inter_dev

# ---------------------------------------------------------------------------
# LiveKit — THE ONE PLACE TO SWITCH BETWEEN LOCAL AND CLOUD
#
# These four variables are the only thing that decides which media server the
# whole system uses. The macOS app does NOT hardcode a LiveKit URL: it connects
# to whatever `serverURL` the token server returns from /room/create,
# /room/join, /meetings/:id/start and the lobby admission poll. So changing
# these four values + restarting the token server is the entire switchover —
# no client rebuild. See docs/CLOUD-LIVEKIT-SETUP.md.
#
# Keep exactly ONE of the two blocks below uncommented.
#
# --- Local dev (livekit-server --dev) -------------------------------------
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
#LIVEKIT_SERVER_URL=ws://localhost:7880
#LIVEKIT_HTTP_URL=http://localhost:7880
#
# --- LiveKit Cloud (paste your values, then restart) ----------------------
# Values come from the LiveKit Cloud dashboard → your project → Settings → Keys.
# The project gives you ONE wss:// URL; the HTTP URL is the same host over https.
#LIVEKIT_API_KEY=API************
#LIVEKIT_API_SECRET=****************************************
#LIVEKIT_SERVER_URL=wss://<your-project>.livekit.cloud
#LIVEKIT_HTTP_URL=https://<your-project>.livekit.cloud
#
# NEVER commit real keys. This file is tracked in git; .env is not.
# ---------------------------------------------------------------------------

# JWT secret for user authentication tokens (NOT LiveKit tokens)
# REQUIRED — server will refuse to start without this set to >= 32 bytes.
# No default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# LiveKit server URL (WebSocket) — returned to the client as `serverURL` and used
# verbatim for the media connection. Local dev: ws://localhost:7880.
# Cloud: wss://<your-project>.livekit.cloud (see the switchover block above).
LIVEKIT_SERVER_URL=ws://localhost:7880

# LiveKit HTTP URL — used by the server-side RoomServiceClient (moderation: mute,
# remove, metadata) and the Egress client (cloud recording). Same host as
# LIVEKIT_SERVER_URL, HTTP scheme. Local dev: http://localhost:7880.
# Cloud: https://<your-project>.livekit.cloud.
# Not derived from LIVEKIT_SERVER_URL — set both explicitly.
LIVEKIT_HTTP_URL=http://localhost:7880

# Token server port
PORT=3000

# ---------------------------------------------------------------------------
# Phase B — Refresh Token System
# Required when implementing Phase B (two-token auth).
# ---------------------------------------------------------------------------

# Secret for signing/verifying refresh token meta-operations.
# REQUIRED for Phase B. Must be >= 32 bytes. Different from JWT_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REFRESH_TOKEN_SECRET=

# Access token TTL (Phase B — replaces 7-day JWT with short-lived access tokens)
ACCESS_TOKEN_TTL=15m

# Refresh token TTL in days (rolling window)
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Phase C — Lemon Squeezy Billing (Merchant of Record)
# Required when implementing Phase C (subscription lifecycle webhooks).
# ---------------------------------------------------------------------------

# Lemon Squeezy API key — from LS Dashboard → Settings → API
# Used server-side only for creating checkouts, managing subscriptions.
# Test mode: separate key from LS test environment
# NEVER expose to client.
LEMONSQUEEZY_API_KEY=

# Lemon Squeezy webhook signing secret — from LS Dashboard → Settings → Webhooks
# Used to verify HMAC-SHA256 signatures in the X-Signature header.
# REQUIRED for billing to function. 6-40 characters.
LEMONSQUEEZY_WEBHOOK_SECRET=

# Lemon Squeezy Store ID — from LS Dashboard → Settings → General
# Required for creating checkout URLs.
LEMONSQUEEZY_STORE_ID=

# App return URL — shown in Lemon Squeezy Checkout redirect after payment
# For dev: http://localhost:3000 | Production: https://your-domain.com
APP_RETURN_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Phase D — Email / Mailer
# Required when implementing Phase D (password reset, email verification).
# Use any SMTP provider: Resend, SendGrid, Postmark, or direct SMTP.
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "from" address shown in password reset and verification emails
SMTP_FROM=noreply@your-domain.com

# ---------------------------------------------------------------------------
# Field encryption — versioned AES-256-GCM (token-server/crypto.js)
#
# Used for calendar OAuth refresh tokens and for interviewer presence notes.
# WITHOUT these the server still starts, but every code path that must store an
# encrypted field FAILS CLOSED rather than storing plaintext — calendar sync is
# unavailable and POST /presence/.../note returns 500 ENCRYPTION_UNAVAILABLE.
#
# ENCRYPTION_ACTIVE_VERSION is the key version NEW ciphertext is written with;
# older versions must stay configured so existing blobs can still be read.
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------

ENCRYPTION_ACTIVE_VERSION=1
ENCRYPTION_SECRET_V1=

# ---------------------------------------------------------------------------
# Presence monitoring (PROVISIONAL — default OFF, and it must stay off)
#
# Candidate presence monitoring for secure interview mode. ONE master flag
# controls the whole feature. Leave PRESENCE_MONITORING_ENABLED unset (or set to
# anything other than "true") and the server behaves exactly as it did before
# the feature existed: the /presence router answers 404 PRESENCE_DISABLED, no
# presence key is written to the room hash, /room/join omits the presence block,
# and the retention sweeper does not start.
#
# DO NOT enable this for real candidates until the false-positive study has
# passed (>= 20 sessions with no second person present and no deliberate
# absence, across varied lighting, rooms, webcams and skin tones, reporting the
# per-session false-positive rate PER EVENT TYPE) and the outstanding legal
# review is complete. PRESENCE_MULTIPLE_FACES_ENABLED in particular must stay
# off until that study shows a per-session false-positive rate under 5% for
# multiple_faces. The study needs real humans in real rooms.
#
# Also: never enable this for EU-resident or under-18 candidates. Both are
# forced to monitoring-off server-side per room, and the AI Act classification
# is unresolved. See .agents/tasks/presence-monitoring/REMOVAL.md to remove the
# feature entirely.
# ---------------------------------------------------------------------------

# The master flag. Anything other than "true" means off.
PRESENCE_MONITORING_ENABLED=false
# Retention window for presence session + event rows, in days (1…3650).
PRESENCE_EVENT_RETENTION_DAYS=90
# The multiple_faces signal. Keep off until the study above passes.
PRESENCE_MULTIPLE_FACES_ENABLED=false
# How long client silence must last before the server records a monitoring_gap.
PRESENCE_GAP_SECONDS=60
# Retention sweeper cadence, in milliseconds (default 1 hour).
PRESENCE_SWEEP_INTERVAL_MS=3600000
# How long a live session may go unreported before the sweeper closes it.
PRESENCE_STALE_SESSION_MINUTES=10
# Where a candidate sends a copy/erasure request. The automated rights endpoint
# is deferred, so requests to this address are handled manually by the operator.
PRESENCE_RIGHTS_CONTACT=privacy@kiomeet.invalid

# ---------------------------------------------------------------------------
# Phase D — Security Alerting (optional but recommended)
# Receives a POST when a stolen refresh token is detected (SESSION_COMPROMISED).
# Set to a Slack Incoming Webhook URL: https://api.slack.com/messaging/webhooks
# Leave blank in dev — alerts are console.error() only when unset.
# ---------------------------------------------------------------------------

SECURITY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Cloud Recording — AWS S3 + LiveKit Egress
# Required only if cloud recording (Pro/Hiring tier) will be used.
# ---------------------------------------------------------------------------

# S3 bucket where LiveKit Egress will write recording files.
# Create this bucket in AWS Console before enabling cloud recording.
# The Egress Docker container also needs these credentials (pass as env vars
# when running: docker run -e AWS_ACCESS_KEY_ID=... livekit/egress)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_RECORDINGS_BUCKET=inter-recordings

# Cloud recording quotas (minutes per user per month)
RECORDING_QUOTA_PRO=600
RECORDING_QUOTA_HIRING=1200

# ---------------------------------------------------------------------------
# LiveKit Egress Service
# The Egress API is a SEPARATE Docker container — not part of the LiveKit server.
# Run it locally with:
#
#   docker run --rm \
#     -e LIVEKIT_URL=ws://localhost:7880 \
#     -e LIVEKIT_API_KEY=devkey \
#     -e LIVEKIT_API_SECRET=secret \
#     -e AWS_ACCESS_KEY_ID=your_key \
#     -e AWS_SECRET_ACCESS_KEY=your_secret \
#     -e AWS_DEFAULT_REGION=us-east-1 \
#     livekit/egress
#
# Without this container running, POST /room/record/start will fail.
# Cloud recording is a Pro/Hiring-only feature — free tier is local only.
# ---------------------------------------------------------------------------

